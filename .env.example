# ============================================
# INFRASTRUKTUR-MANAGER ENVIRONMENT VARIABLES
# ============================================

# ---- SERVER CONFIGURATION ----
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=3000
API_URL=http://localhost:5000

# ---- DATABASE ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=inframan
DB_PASSWORD=change_me_in_production
DB_NAME=inframanager
DATABASE_URL=postgresql://inframan:change_me_in_production@localhost:5432/inframanager

# ---- SECURITY ----
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Master-Key für Credential-Encryption (Base64-encoded 32-byte key)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=your_base64_encoded_master_key_here

# ---- PROXMOX CONFIGURATION ----
PROXMOX_API_ENDPOINT=https://proxmox.local:8006/api2/json
PROXMOX_NODE=pve
# Credentials werden in der App gespeichert & verschlüsselt
# Diese werden nicht hier konfiguriert!

# ---- GITHUB INTEGRATION ----
# GitHub Token wird in der App gespeichert & verschlüsselt
# Diese werden nicht hier konfiguriert!
GITHUB_API_URL=https://api.github.com

# ---- LOGGING ----
LOG_LEVEL=info
LOG_DIR=./logs

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# ---- EMAIL/NOTIFICATIONS (Optional für später) ----
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- SECURITY HEADERS ----
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- SESSION ----
SESSION_TIMEOUT_MINUTES=15
